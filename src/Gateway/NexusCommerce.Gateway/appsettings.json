{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "ruta-catalogo": {
        "ClusterId": "cluster-catalogo",
        "Match": {
          "Path": "/api/catalogo/{**resto}"
        }
      },
      "ruta-autenticacion": {
        "ClusterId": "cluster-identidad",
        "Match": {
          "Path": "/api/autenticacion/{**resto}"
        }
      },
      "ruta-usuarios": {
        "ClusterId": "cluster-identidad",
        "Match": {
          "Path": "/api/usuarios/{**resto}"
        }
      },
      "ruta-pedidos": {
        "ClusterId": "cluster-pedidos",
        "Match": {
          "Path": "/api/pedidos/{**resto}"
        }
      }
    },
    "Clusters": {
      "cluster-catalogo": {
        "Destinations": {
          "catalogo-api": {
            "Address": "http://localhost:5101/"
          }
        }
      },
      "cluster-identidad": {
        "Destinations": {
          "identidad-api": {
            "Address": "http://identity-api:8080/"
          }
        }
      },
      "cluster-pedidos": {
        "Destinations": {
          "pedidos-api": {
            "Address": "http://host.docker.internal:5301/"
          }
        }
      }
    }
  }
}
