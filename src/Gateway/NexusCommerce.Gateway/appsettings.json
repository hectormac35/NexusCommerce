{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "ruta-catalogo": {
        "ClusterId": "cluster-catalogo",
        "Match": {
          "Path": "/api/catalogo/{**resto}"
        }
      },
      "ruta-autenticacion": {
        "ClusterId": "cluster-identidad",
        "Match": {
          "Path": "/api/autenticacion/{**resto}"
        }
      },
      "ruta-usuarios": {
        "ClusterId": "cluster-identidad",
        "Match": {
          "Path": "/api/usuarios/{**resto}"
        }
      },
      "ruta-pedidos": {
        "ClusterId": "cluster-pedidos",
        "Match": {
          "Path": "/api/pedidos/{**resto}"
        }
      }
    },
    "Clusters": {
      "cluster-catalogo": {
        "Destinations": {
          "catalogo-api": {
            "Address": "http://localhost:5101/"
          }
        }
      },
      "cluster-identidad": {
        "Destinations": {
          "identidad-api": {
            "Address": "http://localhost:5201/"
          }
        }
      },
      "cluster-pedidos": {
        "Destinations": {
          "pedidos-api": {
            "Address": "http://localhost:5301/"
          }
        }
      }
    }
  },
  "RabbitMq": {
    "ManagementUrl": "http://localhost:15672",
    "Usuario": "nexus",
    "Contrasena": "nexus_rabbit_password"
  },
  "Jaeger": {
    "QueryUrl": "http://localhost:16686"
  }
}
